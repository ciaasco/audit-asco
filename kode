  if (!sheet || !row || row < 2) return { success: false, message: 'Data tidak valid!' };
  
  sheet.getRange(row, 2).setValue(formData.type);
  sheet.getRange(row, 3).setValue(formData.branch);
  sheet.getRange(row, 4).setValue(formData.borrower);
  sheet.getRange(row, 5).setValue(formData.datePinjam);
  sheet.getRange(row, 6).setValue(formData.dateKembali || '-');
  sheet.getRange(row, 7).setValue(formData.status);
  
  if (fileData && fileData.base64) {
    var uploadRes = uploadFileToDrive(fileData);
    if (uploadRes.success) {
      sheet.getRange(row, 8).setValue(uploadRes.url);
      sheet.getRange(row, 9).setValue(uploadRes.mimeType);
    } else {
      return { success: false, message: 'Gagal upload file baru: ' + uploadRes.errorMsg };
    }
  }
  
  return { success: true, message: 'Data peminjaman berhasil diperbarui!' };
