// Konstanta Tambahan untuk Timeline
const SHEET_TIMELINE = 'Timeline_Audit';

// Fungsi Update Timeline Server (Mendukung Ganti File)
function updateTimelineServer(formData, fileData) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName('Timeline_Audit');
  
  if (!sheet) {
    return { success: false, message: 'Database Timeline tidak ditemukan!' };
  }
  
  var row = parseInt(formData.row);
  if (!row || row < 2) {
    return { success: false, message: 'Baris data tidak valid!' };
  }
  
  // Update data teks standar
  sheet.getRange(row, 2).setValue(formData.name);
  sheet.getRange(row, 3).setValue(formData.bulan);
  sheet.getRange(row, 4).setValue(formData.tahun);
  sheet.getRange(row, 5).setValue(formData.auditor);
  sheet.getRange(row, 6).setValue(formData.status);
  
  // Jika user meng-upload file baru saat edit, upload ke Drive & perbarui Kolom G dan H
  if (fileData && fileData.base64) {
    var uploadRes = uploadFileToDrive(fileData);
    if (uploadRes.success) {
      sheet.getRange(row, 7).setValue(uploadRes.url);      // Kolom G: File URL
      sheet.getRange(row, 8).setValue(uploadRes.mimeType); // Kolom H: Mime Type
    } else {
      return { success: false, message: 'Gagal mengupload file baru: ' + uploadRes.errorMsg };
    }
  }
  
  return { success: true, message: 'Jadwal audit berhasil diperbarui!' };
}

// 1. Upload ke Drive (Pakai Base64 agar kuat kirim file besar)
function uploadFileToDrive(fileData) {
  try {
    var decoded = Utilities.base64Decode(fileData.base64);
    var blob = Utilities.newBlob(decoded, fileData.mimeType, fileData.filename);
    
    var file = DriveApp.createFile(blob);
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    
    return {
      success: true,
      url: file.getUrl(),
      mimeType: fileData.mimeType
    };
  } catch (error) {
    // Tangkap error aslinya agar kita tahu salahnya di mana
    return { success: false, errorMsg: error.toString() };
  }
}

// 2. Simpan Jadwal
function saveTimelineServerWithFile(formData, fileData) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName('Timeline_Audit');
  
  if (!sheet) {
    sheet = ss.insertSheet('Timeline_Audit');
    sheet.appendRow(['ID', 'Nama Cabang', 'Periode Bulan', 'Tahun', 'Auditor PIC', 'Status', 'File URL', 'Mime Type']);
    sheet.setFrozenRows(1);
  }
  
  var data = sheet.getDataRange().getValues();
  
  // Validasi Duplikat
  for (var i = 1; i < data.length; i++) {
    if (
      String(data[i][1]).trim().toLowerCase() === String(formData.name).trim().toLowerCase() &&
      String(data[i][2]).trim().toLowerCase() === String(formData.bulan).trim().toLowerCase() &&
      String(data[i][3]).trim() === String(formData.tahun).trim()
    ) {
      return { success: false, message: 'Jadwal ' + formData.name + ' bulan ' + formData.bulan + ' sudah ada!' };
    }
  }
  
  var fileUrl = '';
  var mimeType = '';
  
  // JIKA ADA FILE, UPLOAD DULU
  if (fileData && fileData.base64) {
    var uploadRes = uploadFileToDrive(fileData);
    
    if (uploadRes.success) {
      fileUrl = uploadRes.url;
      mimeType = uploadRes.mimeType;
    } else {
      // JIKA GAGAL UPLOAD, BATALKAN SIMPAN JADWAL & MUNCULKAN ALERT ERROR!
      return { success: false, message: 'Gagal simpan file ke Drive! Pesan Error: ' + uploadRes.errorMsg };
    }
  }
  
  var nextId = sheet.getLastRow();
  
  sheet.appendRow([
    nextId, formData.name, formData.bulan, formData.tahun, 
    formData.auditor, formData.status, fileUrl, mimeType
  ]);
  
  return { success: true, message: 'Jadwal dan file berhasil disimpan!' };
}

