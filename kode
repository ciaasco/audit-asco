// ==========================================
// 2. KEAMANAN & HASH PASSWORD
// ==========================================

function hashPassword(password) {
  var signature = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, password);
  var hexString = signature.map(function(byte) {
      var v = (byte < 0) ? 256 + byte : byte;
      return ("0" + v.toString(16)).slice(-2);
  }).join("");
  return hexString;
}

// ==========================================
// 3. SETUP DATABASE & PEMBUATAN USER 
// ==========================================

function setupDatabase() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheetUsers = ss.getSheetByName(SHEET_USERS);
  
  if (!sheetUsers) {
    sheetUsers = ss.insertSheet(SHEET_USERS);
    sheetUsers.appendRow(['Username', 'Password (Hash)', 'Role', 'Status', 'Tanggal Dibuat']);
    sheetUsers.setFrozenRows(1); 
    createUserServer('admin', 'password123', 'Admin');
    Logger.log("Database berhasil dibuat. User admin default telah ditambahkan.");
  } else {
    Logger.log("Database Users sudah ada.");
  }
}

function createUserServer(username, password, role) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(SHEET_USERS);
  
  if (!sheet) return { success: false, message: 'Tabel Users belum dibuat!' };

  var data = sheet.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    if (data[i][0].toLowerCase() === username.toLowerCase()) {
      return { success: false, message: 'Username sudah terdaftar! Silakan gunakan username lain.' };
    }
  }

  var hashedPassword = hashPassword(password);
  var timestamp = new Date();
  
  sheet.appendRow([username, hashedPassword, role, 'Active', timestamp]);
  return { success: true, message: 'User ' + username + ' berhasil dibuat dengan role ' + role };
}

// ==========================================
// 4. AUTENTIKASI (LOGIN & GANTI PASSWORD)
// ==========================================

function prosesLogin(username, password) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(SHEET_USERS);
  if (!sheet) return { success: false, message: 'Database belum siap.' };
  
  var data = sheet.getDataRange().getValues();
  var hashedPass = hashPassword(password);
  
  for (var i = 1; i < data.length; i++) {
    if (data[i][0] === username && data[i][1] === hashedPass) {
      if (data[i][3] !== 'Active') return { success: false, message: 'Akun Anda tidak aktif.' };
      return {
        success: true,
        user: { username: data[i][0], role: data[i][2] }
      };
    }
  }
  return { success: false, message: 'Username atau password salah!' };
}

function changePassword(username, oldPassword, newPassword) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(SHEET_USERS);
  var data = sheet.getDataRange().getValues();
  var hashedOld = hashPassword(oldPassword);
  var hashedNew = hashPassword(newPassword);

  for (var i = 1; i < data.length; i++) {
    if (data[i][0] === username && data[i][1] === hashedOld) {
      sheet.getRange(i + 1, 2).setValue(hashedNew);
      return { success: true, message: 'Password berhasil diperbarui!' };
    }
  }
  return { success: false, message: 'Password lama tidak sesuai.' };
}

